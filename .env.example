WORDPRESS_URL=https://wp.groomerhouse.pl
PUBLIC_SITE_URL=https://groomerhouse.pl
# Ustaw true tylko w osobnym wdrożeniu podglądowym (przy buildzie i uruchomieniu).
SEO_NOINDEX=false
BOOKING_PATH=/rezerwacja/
# Formularz trzech pakietów kursu groomerskiego.
BOOKNETIC_ENABLED=true
BOOKING_EMBED_URL=https://wp.groomerhouse.pl/index.php/rezerwacja/
# Opcjonalne identyfikatory pomiarowe (bez nich skrypty nie są ładowane).
# Odczytywane przez proces Node w czasie działania; po zmianie nie trzeba przebudowywać statycznych stron.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Tag Manager — użyj zamiast GA4_MEASUREMENT_ID, jeśli GA4 jest dodane w kontenerze GTM.
# GTM_CONTAINER_ID=GTM-PHLXPT2N
# META_PIXEL_ID=123456789012345
