{
  "name": "groomerhouse-hybrid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "extract:wordpress": "node tools/extract-wordpress.mjs",
    "prepare:assets": "node tools/prepare-assets.mjs",
    "export:wordpress": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/export-wordpress.ps1",
    "dev": "npm run prepare:assets && astro dev --host 127.0.0.1",
    "build": "npm run prepare:assets && astro check && astro build",
    "build:webd": "npm run prepare:assets && astro check && astro build --config astro.config.webd.mjs && node tools/wrap-webd-entry.mjs",
    "export:webd": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/export-webd.ps1",
    "preview": "node dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/vercel": "^11.0.13",
    "astro": "^7.3.8",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
