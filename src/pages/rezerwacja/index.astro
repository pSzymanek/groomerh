---
const wordpress = (import.meta.env.WORDPRESS_URL || "https://groomerhouse.pl").replace(/\/$/, "");
const bookingUrl = `${wordpress}/rezerwacja/?embed=1`;
---
<!doctype html>
<html lang="pl-PL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rezerwacja wizyty | Groomer House</title>
    <meta name="description" content="Umów wizytę w Groomer House przez bezpieczny formularz rezerwacyjny Booknetic." />
    <link rel="icon" href="/wp-content/uploads/2023/08/particles_2-150x150.png" sizes="32x32" />
    <style>
      :root { color: #17142d; font-family: Arial, Helvetica, sans-serif; background: #f8f7fb; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      header { min-height: 92px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 16px clamp(20px, 8vw, 160px); background: white; }
      header img { width: 90px; height: auto; }
      header a { color: #17142d; font-weight: 700; text-decoration: none; }
      main { width: min(1180px, calc(100% - 32px)); margin: 32px auto 64px; }
      h1 { margin: 0 0 10px; font-size: clamp(2rem, 5vw, 4rem); }
      p { color: #5e5b70; margin: 0 0 28px; }
      .frame { min-height: 720px; overflow: hidden; border-radius: 18px; background: white; box-shadow: 0 16px 60px rgba(23, 20, 45, .12); }
      iframe { display: block; width: 100%; min-height: 720px; border: 0; }
      .note { margin-top: 18px; font-size: .9rem; text-align: center; }
      @media (max-width: 640px) { header { min-height: 76px; padding: 10px 18px; } header img { width: 72px; } main { margin-top: 22px; } .frame, iframe { min-height: 780px; border-radius: 12px; } }
    </style>
  </head>
  <body>
    <header>
      <a href="/" aria-label="Groomer House — strona główna"><img src="/wp-content/uploads/2023/08/logo-1.png" alt="Groomer House" /></a>
      <a href="/">Wróć do strony głównej</a>
    </header>
    <main>
      <h1>Umów wizytę</h1>
      <p>Wybierz usługę i dogodny termin w formularzu Groomer House.</p>
      <div class="frame">
        <iframe src={bookingUrl} title="Rezerwacja wizyty Groomer House" loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <p class="note">Formularz nie wyświetla się poprawnie? <a href={bookingUrl} target="_blank" rel="noopener">Otwórz rezerwację w nowym oknie</a>.</p>
    </main>
  </body>
</html>
